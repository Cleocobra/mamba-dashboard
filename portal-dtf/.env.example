# ── Portal DTF ───────────────────────────────────────────────────────────────
# Domínio do site (o Caddy emite o HTTPS sozinho para ele e para www.)
DOMAIN=portaldtf.com.br
PORTAL_PUBLIC_URL=https://portaldtf.com.br

# Marca (provisória até escolher o nome). Trocar aqui muda site, painel e cards.
PORTAL_BRAND_NAME=Portal DTF
PORTAL_TAGLINE=Tutoriais de DTF e estamparia, do arquivo à prensa
PORTAL_SITE_LABEL=portaldtf.com.br
PORTAL_IG_HANDLE=portaldtf
PORTAL_LOGO_MARK=DTF
# WhatsApp das soluções (só dígitos com DDI). Vazio = só o formulário.
PORTAL_WHATSAPP=

# Painel /admin (login básico do navegador)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Segredo do agendador e do cron (Authorization: Bearer ...)
CRON_SECRET=

# Claude (redação dos tutoriais e sugestão de pautas). Modelo padrão: claude-opus-5-5
ANTHROPIC_API_KEY=
# PORTAL_MODEL=claude-opus-5-5

# Instagram (conta Business/Creator + token com instagram_content_publish)
# Descubra com: npm run ig-setup -- --app-id ID --app-secret SEGREDO --token TOKEN_CURTO
IG_USER_ID=
IG_ACCESS_TOKEN=

# true (padrão): às 8h publica todo rascunho não rejeitado. false: só o aprovado no painel.
# Recomendação no começo: false, até confiar na qualidade dos textos.
PORTAL_AUTO_PUBLISH=false
# Quantos tutoriais o agendador gera por dia (1 a 5)
PORTAL_ARTICLES_PER_RUN=1
# Horários (Brasília) do agendador embutido
PORTAL_RUN_HOUR=6
PORTAL_PUBLISH_HOUR=8

# Docker: "edge" liga o Caddy (porta 80/443). Deixe vazio se outro proxy já usa essas portas.
COMPOSE_PROFILES=edge

# Redis: no Docker é automático (redis://redis:6379). Na Vercel use o Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Prefixo das chaves (útil se dividir o Redis com outro projeto)
# PORTAL_REDIS_PREFIX=portaldtf
