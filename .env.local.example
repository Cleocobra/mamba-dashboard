# ── Loja Integrada API (obrigatório) ────────────────────────────────────────
# Painel LI → Configurações → API
LI_CHAVE_API=sua-chave-api
LI_CHAVE_APLICACAO=sua-chave-aplicacao

# ── Segurança (obrigatório em produção) ─────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Usuário admin criado no primeiro boot (se o Redis estiver vazio)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=

# ── White-label (opcional — sem definir, usa marca Mamba Army) ──────────────
# APP_SLUG controla nomes de container/rede/volume no docker compose
APP_SLUG=minhaloja
NEXT_PUBLIC_STORE_NAME=Minha Loja
# Arquivo dentro de public/ (pode ser adicionado sem commit — .dockerignore não exclui)
NEXT_PUBLIC_STORE_LOGO=/logo-minhaloja.png

# ── Meta Ads API (opcional — página Anúncios) ───────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_1=
META_AD_ACCOUNT_2=

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dashboard.exemplo.com.br

# ── Redis ────────────────────────────────────────────────────────────────────
# No VPS o docker-compose.yml já define REDIS_URL automaticamente.
# Na Vercel (serverless), use Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
