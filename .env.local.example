# Loja Integrada API
LI_CHAVE_API=c9b02688ef5097ab6a26
LI_CHAVE_APLICACAO=df63ca80-5968-4476-9b43-11189846cb9a

# Meta Ads API (preencher após conectar conta Meta)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# App URL
NEXT_PUBLIC_APP_URL=https://dashboard.mamba.army

# ── SC em Alta (notícias diárias + Instagram) ──────────────────────────────
# Claude (edição das notícias). Modelo padrão: claude-opus-5.
ANTHROPIC_API_KEY=
# SCEMALTA_MODEL=claude-opus-5

# Brave News API (opcional; sem ela a coleta usa só os feeds RSS)
BRAVE_API_KEY=
# Feeds RSS (opcional). Formato: "Nome|https://url,Nome2|https://url2"
# SCEMALTA_RSS_FEEDS=

# Instagram (conta Business/Creator + token com instagram_content_publish)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Segredo do cron (Authorization: Bearer ...) para /api/scemalta/run e /publish
CRON_SECRET=

# URL pública base para as imagens dos cards (o Instagram baixa daqui)
SCEMALTA_PUBLIC_URL=https://scemalta.com.br
# Host que serve o site público na raiz (nginx → mesmo container)
SCEMALTA_HOST=scemalta.com.br
# true (padrão): o cron das 8h publica tudo que não foi rejeitado. false: só o que foi aprovado.
SCEMALTA_AUTO_PUBLISH=true
