# ── SC em Alta ───────────────────────────────────────────────────────────────
# Domínio do site (o Caddy emite o HTTPS sozinho para ele e para www.)
DOMAIN=scemalta.com.br
SCEMALTA_PUBLIC_URL=https://scemalta.com.br

# Painel /admin (login básico do navegador)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Segredo do agendador e do cron (Authorization: Bearer ...)
CRON_SECRET=

# Claude (edição das notícias). Modelo padrão: claude-opus-5
ANTHROPIC_API_KEY=
# SCEMALTA_MODEL=claude-opus-5

# Brave News API (opcional; sem ela a coleta usa só os feeds RSS)
BRAVE_API_KEY=
# Feeds RSS (opcional). Formato: "Nome|https://url,Nome2|https://url2"
# SCEMALTA_RSS_FEEDS=

# Instagram (conta Business/Creator + token com instagram_content_publish)
# Descubra com: npm run ig-setup -- --app-id ID --app-secret SEGREDO --token TOKEN_CURTO
IG_USER_ID=
IG_ACCESS_TOKEN=

# true (padrão): publica às 8h tudo que não foi rejeitado no painel. false: só o aprovado.
SCEMALTA_AUTO_PUBLISH=true
# Horários (Brasília) do agendador embutido
SCEMALTA_RUN_HOUR=6
SCEMALTA_PUBLISH_HOUR=8

# Docker: "edge" liga o Caddy (porta 80/443). Deixe vazio se outro proxy já usa essas portas.
COMPOSE_PROFILES=edge

# Redis: no Docker é automático (redis://redis:6379). Na Vercel use o Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
